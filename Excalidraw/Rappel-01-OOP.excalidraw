      "fontFamily": 8,
      "strokeColor": "#e5e5e5",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "abs",
      "originalText": "Abstract class\n• abstract methods (no body)\n• cannot be instantiated\n• subclass must implement all\n• can mix concrete + abstract",
      "autoResize": true
    },
