    {
      "type": "text",
      "id": "tvis",
      "x": 33.497497055359304,
      "y": 85,
      "width": 338.78472900390625,
      "height": 160,
      "text": "Visibility (least → most open)\n• private: class only\n• (package): same package\n• protected: package + subclasses\n• public: everywhere\n\nextends: single (classes), multi (interfaces)\nimplements: class → interface(s)",
      "fontSize": 14,
      "fontFamily": 8,
      "strokeColor": "#e5e5e5",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "vis",
      "originalText": "Visibility (least → most open)\n• private: class only\n• (package): same package\n• protected: package + subclasses\n• public: everywhere\n\nextends: single (classes), multi (interfaces)\nimplements: class → interface(s)",
