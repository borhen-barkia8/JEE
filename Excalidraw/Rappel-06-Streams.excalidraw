    { "type": "arrow", "id": "a2", "x": 560, "y": 130, "width": 60, "height": 0, "points": [[0,0],[60,0]], "endArrowhead": "arrow", "strokeColor": "#e5e5e5", "startBinding": { "elementId": "inter", "fixedPoint": [1, 0.5] }, "endBinding": { "elementId": "term", "fixedPoint": [0, 0.5] } },

    { "type": "rectangle", "id": "notes", "x": 120, "y": 230, "width": 660, "height": 110, "roundness": { "type": 3 }, "backgroundColor": "#5c3d1a", "fillStyle": "solid", "strokeColor": "#f59e0b", "boundElements": [{ "id": "tnotes", "type": "text" }] },
    { "type": "text", "id": "tnotes", "x": 130, "y": 245, "width": 640, "height": 80, "text": "• Stream does not store data; it processes elements from a source\n• Intermediate ops are lazy (no work until terminal op)\n• A stream is single-use (cannot reuse after terminal op)\n• Collectors.toList(), toSet(), joining(), groupingBy() produce results", "fontSize": 14, "fontFamily": 8, "strokeColor": "#e5e5e5", "textAlign": "left", "verticalAlign": "middle", "containerId": "notes", "originalText": "• Stream does not store data; it processes elements from a source\n• Intermediate ops are lazy (no work until terminal op)\n• A stream is single-use (cannot reuse after terminal op)\n• Collectors.toList(), toSet(), joining(), groupingBy() produce results", "autoResize": true }
  ],
