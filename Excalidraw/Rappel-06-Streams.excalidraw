    { "type": "text", "id": "tsrc", "x": 50, "y": 105, "width": 160, "height": 50, "text": "Source\nCollection / Array\nStream.of(...)", "fontSize": 14, "fontFamily": 8, "strokeColor": "#e5e5e5", "textAlign": "center", "verticalAlign": "middle", "containerId": "src", "originalText": "Source\nCollection / Array\nStream.of(...)", "autoResize": true },

