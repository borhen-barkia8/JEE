    { "type": "text", "id": "tinter", "x": 290, "y": 85, "width": 260, "height": 90, "text": "Intermediate (lazy)\nfilter, map, flatMap\nsorted, distinct\nlimit, skip, peek", "fontSize": 14, "fontFamily": 8, "strokeColor": "#e5e5e5", "textAlign": "center", "verticalAlign": "middle", "containerId": "inter", "originalText": "Intermediate (lazy)\nfilter, map, flatMap\nsorted, distinct\nlimit, skip, peek", "autoResize": true },

