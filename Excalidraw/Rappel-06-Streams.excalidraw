    { "type": "text", "id": "tterm", "x": 630, "y": 85, "width": 230, "height": 90, "text": "Terminal (triggers run)\ncollect, forEach, reduce\ncount, min, max\nfindFirst, anyMatch", "fontSize": 14, "fontFamily": 8, "strokeColor": "#e5e5e5", "textAlign": "center", "verticalAlign": "middle", "containerId": "term", "originalText": "Terminal (triggers run)\ncollect, forEach, reduce\ncount, min, max\nfindFirst, anyMatch", "autoResize": true },

