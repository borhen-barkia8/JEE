    {
      "type": "text",
      "id": "ttypes",
      "x": 50,
      "y": 245,
      "width": 350,
      "height": 140,
      "text": "Injection Types\n\n1. Constructor (recommended)\n   - required deps, immutable, testable\n2. Setter (@Autowired)\n   - optional / reconfigurable\n3. Field (@Autowired)\n   - concise but harder to test",
      "fontSize": 14,
      "fontFamily": 8,
      "strokeColor": "#e5e5e5",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "types",
      "originalText": "Injection Types\n\n1. Constructor (recommended)\n   - required deps, immutable, testable\n2. Setter (@Autowired)\n   - optional / reconfigurable\n3. Field (@Autowired)\n   - concise but harder to test",
      "autoResize": true
    },
