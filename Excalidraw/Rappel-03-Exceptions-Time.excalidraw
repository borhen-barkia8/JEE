    {
      "type": "text",
      "id": "tex",
      "x": 50,
      "y": 95,
      "width": 360,
      "height": 210,
      "text": "Exceptions (Throwable)\n\n• throw: raise an exception\n• throws: declare propagation (checked)\n• try/catch: handle it\n• finally: always runs (cleanup)\n• printStackTrace(): diagnostics\n\nChecked: extends Exception\nUnchecked: extends RuntimeException\n(need not be declared)",
      "fontSize": 14,
      "fontFamily": 8,
      "strokeColor": "#e5e5e5",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "ex",
      "originalText": "Exceptions (Throwable)\n\n• throw: raise an exception\n• throws: declare propagation (checked)\n• try/catch: handle it\n• finally: always runs (cleanup)\n• printStackTrace(): diagnostics\n\nChecked: extends Exception\nUnchecked: extends RuntimeException\n(need not be declared)",
      "autoResize": true
    },
