    {
      "type": "text",
      "id": "twarn",
      "x": 130,
      "y": 305,
      "width": 640,
      "height": 70,
      "text": "Equality semantics: List uses equals() for contains/indexOf.\nTreeSet/TreeMap use compareTo/compare == 0 as duplicates → inconsistent comparator can drop elements!\nSearching: indexOf/lastIndexOf are List methods (cast if needed).",
      "fontSize": 14,
      "fontFamily": 8,
      "strokeColor": "#e5e5e5",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "warn",
      "originalText": "Equality semantics: List uses equals() for contains/indexOf.\nTreeSet/TreeMap use compareTo/compare == 0 as duplicates → inconsistent comparator can drop elements!\nSearching: indexOf/lastIndexOf are List methods (cast if needed).",
      "autoResize": true
    }
  ],
